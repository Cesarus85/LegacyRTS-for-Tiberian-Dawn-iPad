{
    "version": 6,
    "configurePresets": [
        {
            "name": "ipados-device-local",
            "inherits": "ipados-device",
            "displayName": "Tiberian Dawn for iPad — My iPad",
            "binaryDir": "${sourceDir}/build/ipados-device",
            "cacheVariables": {
                "IPADOS_BUNDLE_IDENTIFIER": "com.example.tiberian-dawn-for-ipad",
                "IPADOS_DEVELOPMENT_TEAM": "YOUR_TEAM_ID"
            }
        },
        {
            "name": "gcc-vanilla-debug",
            "inherits": "gcc-vanilla",
            "displayName": "GCC Vanilla debug build",
            "binaryDir": "${sourceDir}/build_gcc",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "clang-vanilla-debug",
            "inherits": "clang-vanilla",
            "displayName": "Clang Vanilla debug build",
            "binaryDir": "${sourceDir}/build_clang",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw-i686-vanilla-debug",
            "inherits": "mingw-i686-vanilla",
            "displayName": "MinGW-w64 32bit Vanilla debug build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw-x86_64-vanilla-debug",
            "inherits": "mingw-x86_64-vanilla",
            "displayName": "MinGW-w64 64bit Vanilla debug build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ipados-device-local",
            "configurePreset": "ipados-device-local",
            "displayName": "Tiberian Dawn for iPad — My iPad (Debug)",
            "configuration": "Debug",
            "targets": ["TiberianDawn"]
        },
        {
            "name": "ipados-device-local-release",
            "configurePreset": "ipados-device-local",
            "displayName": "Tiberian Dawn for iPad — My iPad (Release)",
            "configuration": "Release",
            "targets": ["TiberianDawn"]
        }
    ]
}
