+- (void)tiberianDawnPushVisionEvent:(Sint32)code location:(CGPoint)location
+{
+    CGRect bounds = self.bounds;
+    const double normalizedX = bounds.size.width > 0.0 ? (location.x - bounds.origin.x) / bounds.size.width : 0.0;
+    const double normalizedY = bounds.size.height > 0.0 ? (location.y - bounds.origin.y) / bounds.size.height : 0.0;
+    SDL_Event event;
+    SDL_zero(event);
+    event.type = SDL_USEREVENT;
+    event.user.timestamp = SDL_GetTicks();
+    event.user.code = code;
+    event.user.data1 = (void *)(uintptr_t)llround(fmax(0.0, fmin(1.0, normalizedX)) * 1000000.0);
+    event.user.data2 = (void *)(uintptr_t)llround(fmax(0.0, fmin(1.0, normalizedY)) * 1000000.0);
+    SDL_PushEvent(&event);
+}
+
+- (void)tiberianDawnPushVisionLookScrollDelta:(CGPoint)delta
+{
+    CGRect bounds = tiberianDawnVisionLookScrollView.bounds;
+    const double normalizedX = bounds.size.width > 0.0 ? delta.x / bounds.size.width : 0.0;
+    const double normalizedY = bounds.size.height > 0.0 ? delta.y / bounds.size.height : 0.0;
+    SDL_Event event;
+    SDL_zero(event);
+    event.type = SDL_USEREVENT;
+    event.user.timestamp = SDL_GetTicks();
+    event.user.code = TIBERIAN_DAWN_VISION_LOOK_SCROLL;
+    event.user.data1 = (void *)(intptr_t)llround(normalizedX * 1000000.0);
+    event.user.data2 = (void *)(intptr_t)llround(normalizedY * 1000000.0);
+    SDL_PushEvent(&event);
+}
