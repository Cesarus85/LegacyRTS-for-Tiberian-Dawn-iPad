+    tiberianDawnVisionLookScrollResetting = YES;
+    tiberianDawnVisionLookScrollView.contentSize = CGSizeMake(size.width * 101.0, size.height * 101.0);
+    tiberianDawnVisionLookScrollLastOffset = CGPointMake(size.width * 50.0, size.height * 50.0);
